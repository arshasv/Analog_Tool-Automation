# ============================================================================
# Environment Configuration Template
# Copy this to .env and customize as needed
# ============================================================================

# Application
APP_NAME=AI-Driven Sky130 ASIC Platform
APP_VERSION=0.1.0
DEBUG=true

# API Configuration
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database
# For development, SQLite is fine
DATABASE_URL=sqlite:///./data/platform.db

# For production, use PostgreSQL
# DATABASE_URL=postgresql://eda:eda_password@postgres:5432/eda_platform

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# PDK Configuration (set automatically in Docker)
PDK_ROOT=/opt/sky130_pdk
PDK_NAME=sky130A
SKY130_PDK=/opt/sky130_pdk/sky130A

# EDA Tools Paths
NGSPICE_BIN=/usr/local/bin/ngspice
MAGIC_BIN=/usr/local/bin/magic
NETGEN_BIN=/usr/local/bin/netgen
KLAYOUT_BIN=/opt/klayout-src/bin-release/klayout

# Working Directories
WORK_DIR=./data/designs
RESULTS_DIR=./data/results
CACHE_DIR=./data/cache

# Simulation Settings
MAX_SIMULATION_TIME=300
SIMULATION_TIMEOUT=60

# AI Engine Settings
AI_ENABLED=true
MAX_OPTIMIZATION_ITERATIONS=100
OPTIMIZATION_TIMEOUT=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/platform.log

# Security (for production)
# SECRET_KEY=your-secret-key-here
# ALLOWED_HOSTS=localhost,127.0.0.1
